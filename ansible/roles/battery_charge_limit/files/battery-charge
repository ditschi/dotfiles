#!/bin/bash
# Battery charge thresholds: battery-charge [status|normal|full]
# Uses the kernel's generic interface (charge_control_*_threshold); a battery that only
# offers a stop threshold gets just that one.
set -euo pipefail

CHARGE_START=75
CHARGE_STOP=80
# shellcheck disable=SC1091
[ -r /etc/default/battery-charge-limit ] && . /etc/default/battery-charge-limit
SUPPLY_DIR="${POWER_SUPPLY_DIR:-/sys/class/power_supply}"

action="${1:-status}"
case "$action" in
    status | normal | full) ;;
    *)
        echo "usage: battery-charge [status|normal|full]" >&2
        exit 2
        ;;
esac

set_thresholds() {
    if [ -e "$bat/charge_control_start_threshold" ]; then
        # Reset start first so any new start/stop pair is accepted.
        echo 0 >"$bat/charge_control_start_threshold"
        echo "$2" >"$bat/charge_control_end_threshold"
        echo "$1" >"$bat/charge_control_start_threshold"
    else
        echo "$2" >"$bat/charge_control_end_threshold"
    fi
}

found=0
# All batteries: models like the T470 have two (BAT0, BAT1).
for bat in "$SUPPLY_DIR"/BAT*; do
    [ -e "$bat/charge_control_end_threshold" ] || continue
    found=1
    case "$action" in
        normal) set_thresholds "$CHARGE_START" "$CHARGE_STOP" ;;
        full) set_thresholds 95 100 ;;
    esac
    start="$(cat "$bat/charge_control_start_threshold" 2>/dev/null || echo -)"
    echo "${bat##*/}: $(cat "$bat/capacity")% $(cat "$bat/status")," \
        "charge between ${start}% and $(cat "$bat/charge_control_end_threshold")%"
done
if [ "$found" = 0 ]; then
    echo "battery-charge: no battery with charge thresholds"
fi
