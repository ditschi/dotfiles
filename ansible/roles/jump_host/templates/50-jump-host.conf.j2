# generated by machine (feature jump-host) - do not edit
# Reverse tunnels only: each key may listen on its own loopback port (permitlisten).
Match User {{ jump_host_user }}
    AllowTcpForwarding remote
    GatewayPorts no
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    AllowStreamLocalForwarding no
    PermitTunnel no
    ClientAliveInterval 30
    ClientAliveCountMax 3
    ForceCommand /usr/sbin/nologin
