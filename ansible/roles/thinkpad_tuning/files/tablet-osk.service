[Unit]
Description=On-screen keyboard in tablet mode
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/sys/devices/platform/thinkpad_acpi/hotkey_tablet_mode

[Service]
ExecStart=/usr/local/lib/machine/tablet_osk.py
Restart=on-failure

[Install]
WantedBy=graphical-session.target
