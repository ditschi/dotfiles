#!/usr/bin/env bash
# One-command bootstrap. Run on the new host, or with --limit from a control node.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MACHINE="$ROOT/home/dot_local/bin/executable_machine"

if [[ ! -x $MACHINE ]]; then
    chmod +x "$MACHINE"
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "bootstrap: installing uv (https://astral.sh/uv)"
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$HOME/.local/bin" sh
    export PATH="$HOME/.local/bin:$PATH"
fi

exec "$MACHINE" setup "$@"
