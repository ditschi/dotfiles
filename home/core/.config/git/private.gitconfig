# Private identity + GitHub credentials. Included by the owner rules in ~/.gitconfig
# or per repo via `git user-private`.
[user]
    name = Christian Ditscher
    email = chris@ditscher.me

[credential "https://github.com"]
    username = ditschi
    # empty value drops earlier helpers (store), so tokens never land in ~/.git-credentials
    helper =

# The token helper itself, written by `machine` from the host config: GITHUB_TOKEN on
# private hosts, GITHUB_PRIVATE_TOKEN on work hosts (where GITHUB_TOKEN is the work
# token). Must come after the reset above; a missing file means no token helper.
[include]
    path = ~/.config/git/github-token.gitconfig
