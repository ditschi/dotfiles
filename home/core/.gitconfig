# Shared git config — tracked in dotfiles, identical on every host.
# `git config --global ...` writes here (symlink into the repo), so new aliases get shared.
# Host-only settings (user, signing, safe.directory, credentials, proxy) belong in
# ~/.gitconfig.local (created once by machine, never overwritten). A pre-commit hook
# rejects them in this file.

[color]
    ui = true
    branch = auto
    diff = auto
    status = auto
[color "branch"]
    current = red reverse
    local = blue
    remote = green
[color "diff"]
    meta = yellow
    frag = magenta
    old = red bold
    new = green
    plain = white
[color "status"]
    added = green
    changed = yellow
    untracked = cyan

[user]
    # never guess name/email from hostname; the default comes from ~/.gitconfig.local
    useConfigOnly = true
[alias]
    st = status
    cl = clone
    sm = submodule
    co = checkout
    cm = commit -m
    ci = commit
    br = branch
    su = submodule update --recursive
    sui = submodule update --init --recursive
    ssr = submodule status --recursive
    # removes a submodule and makes the files native in the repo
    rmsm = "!f() { d=\"$1\"; mv -- \"$d\" \"${d}_tmp\" && git submodule deinit -- \"$d\" && git rm --cached -- \"$d\" && mv -- \"${d}_tmp\" \"$d\" && git add -- \"$d\"; }; f"

    ca = commit --amend -C HEAD
    # Amend and add back the files that were part of HEAD, forwarding args; works in sh/bash/zsh
    caa = "!f() { git diff-tree --root --no-commit-id --name-only -z -r HEAD | xargs -0 -I{} git add -- \"{}\"; git commit --amend \"$@\" -C HEAD; }; f"
    caaa = commit -a --amend -C HEAD
    # "p" variants reuse the base alias and then push with --force-with-lease
    cap = !sh -c 'git ca "$@" && git push --force-with-lease' -
    caap = !sh -c 'git caa "$@" && git push --force-with-lease' -
    caaap = !sh -c 'git caaa "$@" && git push --force-with-lease' -
    redo = caaap

    # shows all changes which will be included in next commit (staged changes)
    curr-diff = diff --cached
    cdiff = diff --cached
    undo = !sh -c 'git stash push --keep-index -m "undo-temp" && git stash drop -q' -
    commit-all = !sh -c 'git add -A && git commit' -
    unstage = "reset HEAD"
    lol = "log --graph --decorate --pretty=oneline --abbrev-commit --all"
    cob = !sh -c 'git fetch -q && git checkout -b "$1" origin/"$1"' -
    # CheckOut Clean
    coc = "!f() { git checkout -f -- \"$1\" && git pull origin && git submodule update --init --recursive && git clean -df -f && git submodule foreach --recursive 'git clean -df -f' && git status; }; f"
    tidy = "!git checkout -f; git clean -dff; git submodule foreach 'git checkout -f && git clean -dff'; git submodule update --init --recursive; git clean -dff; git status"
    fresh = "!git reset --hard; git clean -dff; git submodule foreach 'git reset --hard && git clean -dff'; git submodule update --init --recursive"
    # update branch from origin -- no need to check out
    u2d = !sh -c 'git fetch origin -u "$1":"$1"' -
    # updates all branches from remote (faster: fetch all and prune)
    uab = !sh -c 'git fetch --all --prune' -
    # deletes all local branches not on server
    clean-branches = "!f() { git checkout -q develop && git fetch -q --prune; TODELETE=$(git for-each-ref --format='%(refname:short)|%(upstream:track)' refs/heads/ | while IFS='|' read -r name track; do case \"$track\" in *gone*) echo \"$name\";; esac; done); if [ -n \"$TODELETE\" ]; then echo \"$TODELETE\" | xargs git branch -d; fi; }; f"
    clb = clean-branches
    # deletes all local tags and re-fetches from origin (safe loop to handle spaces)
    clean-tags = "!f() { git tag -l | while IFS= read -r t; do [ -n \"$t\" ] && git tag -d \"$t\"; done; git fetch --tags; }; f"
    clt = clean-tags
    reset-to-origin = "!git fetch origin && git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)"
    # rework-commit-messages: replace leading issue IDs in commit messages by rebasing.
    # Usage: git rework-commit-messages [BASE_BRANCH]
    rework-commit-messages = "!bash -c 'BASE_BRANCH=${1:-$(git symbolic-ref refs/remotes/origin/HEAD)}; NEW_ISSUE_ID=$(git rev-parse --abbrev-ref HEAD | grep -oE \"[A-Z]{2,}-[0-9]+\"); git rebase --exec \"CURRENT_MESSAGE=\\$(git show -s --format=%B); NEW_MESSAGE=\\$(echo \\\"\\$CURRENT_MESSAGE\\\" | sed -E \\\"s/^[A-Z]{2,}-[0-9]+/$NEW_ISSUE_ID/\\\"); git commit --amend -m \\\"\\$NEW_MESSAGE\\\"\" \"$BASE_BRANCH\"' -"
    branch-change-issue-id = "!f() { NEW_ISSUE_ID=\"$1\"; OLD_ISSUE_ID=$(git rev-parse --abbrev-ref HEAD | grep -oE '[A-Z]{2,}-[0-9]+'); NEW_BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD | sed -E \"s/$OLD_ISSUE_ID/$NEW_ISSUE_ID/\"); git checkout -b \"$NEW_BRANCH_NAME\"; }; f"

    smlog = log --full-diff -p
    slmog = smlog
    ldiff = diff HEAD^ HEAD

    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    lf = ll
    le = log --oneline --decorate
    filelog = log -u
    fl = log -u
    bclean = "!f() { BR=${1:-develop}; LIST=$(git branch --merged \"$BR\" --format='%(refname:short)' | grep -vx -e \"$BR\" -e \"$(git branch --show-current)\"); if [ -n \"$LIST\" ]; then echo \"$LIST\" | xargs git branch -d; fi; }; f"

    la = "!git config --get-regexp '^alias\\.' | sed -E 's/^alias\\.//; s/ .*//'"

    # identity + credentials: host default in ~/.gitconfig.local, owner rules at the end; these override one repo
    user-work = "!f() { git user-unset-local; git config --local --add include.path ~/.config/git/work.gitconfig; }; f"
    user-private = "!f() { git user-unset-local; git config --local --add include.path ~/.config/git/private.gitconfig; }; f"
    user-show = "!f() { echo \"repo  : $(git config --local --includes user.name) <$(git config --local --includes user.email)>\"; echo \"host  : $(git config -f ~/.gitconfig.local user.name) <$(git config -f ~/.gitconfig.local user.email)>\"; echo \"active: $(git config user.name) <$(git config user.email)>\"; echo \"github: $(git config --get-urlmatch credential.username https://github.com)\"; }; f"
    user-unset-local = "!f() { git config --local --unset-all include.path 'config/git/(work|private)[.]gitconfig$'; git config --local --unset-all user.name; git config --local --unset-all user.email; true; }; f"

    # conflict/merges
    ours = !sh -c 'git checkout --ours "$@" && git add -- "$@"' -
    theirs = !sh -c 'git checkout --theirs "$@" && git add -- "$@"' -
    # host-only setting -> ~/.gitconfig.local, not the shared file
    store = !git config --file ~/.gitconfig.local credential.helper store
    root = rev-parse --show-toplevel
    rc = rebase --continue
    ra = rebase --abort
    r2 = rebase -i HEAD~2
    r3 = rebase -i HEAD~3
    r4 = rebase -i HEAD~4
    r5 = rebase -i HEAD~5
    l = log -1
    l1 = log -1
    l2 = log -2
    l3 = log -3
    l4 = log -4
    l5 = log -5
    set-upstream-default = !git branch --set-upstream-to=origin/$(git rev-parse --abbrev-ref HEAD)

[merge]
    tool = meld
[diff]
    tool = meld
    algorithm = patience
[difftool]
    prompt = false
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"
[mergetool "meld"]
    cmd = meld "$LOCAL" "$BASE" "$REMOTE" --output "$MERGED"

[core]
    preloadindex = true
    autocrlf = input
    # delta (from mise) when installed, else less, else plain output
    pager = "sh -c 'if command -v delta >/dev/null 2>&1; then delta; elif command -v less >/dev/null 2>&1; then less -FXRi; else cat; fi'"
[interactive]
    diffFilter = "sh -c 'if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi'"
[delta]
    navigate = true

[gc]
    auto = 256
[init]
    defaultBranch = main
[help]
    autocorrect = 1
[status]
    submoduleSummary = false
[push]
    default = current
    recurseSubmodules = on-demand
[pull]
    rebase = true
[fetch]
    recurseSubmodules = no
    prune = true
[rerere]
    enabled = true
    autoupdate = true
[lfs]
    defaulttokenttl = true
    contenttype = false
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# Host-local values override everything above except the owner rules below.
[include]
    path = ~/.gitconfig.local

# Identity + credentials by repo owner. Must stay last; later rules win and
# repo-local config (`git user-work` / `git user-private`) wins over all.
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.config/git/private.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/private.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/bosch-*/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/bosch_*/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/*_bosch/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:bosch-*/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:bosch_*/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:*_bosch/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.boschdevcloud.com/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://sourcecode*.bosch.com/**"]
    path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://*@sourcecode*.bosch.com*/**"]
    path = ~/.config/git/work.gitconfig
