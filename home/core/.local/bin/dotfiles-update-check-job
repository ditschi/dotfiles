#!/usr/bin/env bash
set -u

repo="${DOTFILES_REPO:-$HOME/dotfiles}"
marker="${DOTFILES_UPDATE_MARKER:-$HOME/.dotfiles-update-available}"
state_file="${DOTFILES_UPDATE_STATE:-$HOME/.dotfiles-update-state}"
last_check_file="${DOTFILES_UPDATE_LAST_CHECK:-$HOME/.dotfiles-update-last-check}"

date -Is >"$last_check_file"

if [ ! -d "$repo/.git" ]; then
    exit 0
fi

# machine fetches, applies home-only changes unattended and writes the state
machine_bin="$HOME/.local/bin/machine"
[ -x "$machine_bin" ] || machine_bin="$(command -v machine || true)"
if [ -n "$machine_bin" ]; then
    exec "$machine_bin" update --auto
fi

# Fallback without the machine CLI: only fetch and record the state

if ! git -C "$repo" fetch --quiet; then
    exit 0
fi

branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ -z "$branch" ]; then
    exit 0
fi

upstream_ref="origin/$branch"
if ! git -C "$repo" rev-parse --verify "$upstream_ref" >/dev/null 2>&1; then
    exit 0
fi

write_state() {
    local state="$1" reason="${2:-}" revision tmp
    revision="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
    tmp="$state_file.$$"
    printf 'state=%s\nreason=%s\nrevision=%s\n' "$state" "$reason" "$revision" >"$tmp" &&
        mv -f "$tmp" "$state_file"
}

if ! git -C "$repo" merge-base --is-ancestor HEAD "$upstream_ref" 2>/dev/null &&
    ! git -C "$repo" merge-base --is-ancestor "$upstream_ref" HEAD 2>/dev/null; then
    write_state attention "history has diverged from $upstream_ref"
    exit 0
fi

pending_count="$(git -C "$repo" rev-list --count "HEAD..$upstream_ref" 2>/dev/null || echo 0)"
if [ "${pending_count:-0}" -gt 0 ]; then
    : >"$marker"
    write_state available
else
    rm -f "$marker"
    write_state none
fi
