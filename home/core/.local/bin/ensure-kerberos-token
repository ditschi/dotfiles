#!/usr/bin/env bash
set -euo pipefail

# Keep the Kerberos ticket valid; the logic lives in work-net (work hosts only).
if ! command -v work-net >/dev/null 2>&1; then
    echo "ensure-kerberos-token: work-net not installed (work hosts only)" >&2
    exit 0
fi
exec work-net kerberos refresh --auto "$@"
