#!/usr/bin/env bash
set -euo pipefail

# Print the owner's password: env files first, then the GNOME keyring (spec kerberos-tokens).
# Usage: get-password [USERNAME]   (defaults to the current user)

user="${1:-$(id -un)}"
keyring_timeout="${GET_PASSWORD_KEYRING_TIMEOUT:-5}"

if [[ -z ${PASSWORD:-} ]]; then
    common="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../../.shell/common"
    # shellcheck source=../../.shell/common/envfiles.sh
    . "$common/envfiles.sh"
    # Env files are written for interactive shells, not for errexit/nounset.
    set +eu
    dotfiles_load_envfiles
    set -eu
fi

if [[ -n ${PASSWORD:-} ]]; then
    printf '%s\n' "$PASSWORD"
    exit 0
fi

# Reading a locked collection would open an unlock dialog, so ask D-Bus first.
keyring_unlocked() {
    local state
    state=$(timeout "$keyring_timeout" busctl --user get-property org.freedesktop.secrets \
        /org/freedesktop/secrets/aliases/default org.freedesktop.Secret.Collection Locked \
        2>/dev/null) || return 1
    [[ $state == "b false" ]]
}

if command -v secret-tool >/dev/null 2>&1 && keyring_unlocked; then
    result=$(timeout "$keyring_timeout" secret-tool lookup password "$user" 2>/dev/null || true)
    if [[ -n $result ]]; then
        printf '%s\n' "$result"
        exit 0
    fi
fi

echo "get-password: no password in the env files (PASSWORD) or the unlocked keyring for user '$user'" >&2
exit 1
