#!/bin/sh
# Git credential helper: password from env var $1, else from ~/.env via the shell loader
# (covers GUI-started VS Code). Never stores anything.
# gitconfig: helper = !$HOME/.local/bin/git-credential-env VAR_NAME
var=$1
action=$2

case $var in
    '' | [0-9]* | *[!A-Za-z0-9_]*)
        echo "git-credential-env: invalid variable name '$var'" >&2
        exit 1
        ;;
esac
[ "$action" = get ] || exit 0

username=
while IFS= read -r line && [ -n "$line" ]; do
    case $line in username=*) username=${line#username=} ;; esac
done

token=$(printenv "$var")
loader=$HOME/.shell/common/environment.sh
if [ -z "$token" ] && [ -f "$loader" ] && command -v bash >/dev/null 2>&1; then
    token=$(bash -c '. "$1" >/dev/null 2>&1; printenv "$2"' _ "$loader" "$var")
fi

if [ -z "$token" ]; then
    echo "git-credential-env: $var is not set (environment or ~/.env)" >&2
    exit 0
fi
printf 'username=%s\npassword=%s\n' "${username:-x-access-token}" "$token"
