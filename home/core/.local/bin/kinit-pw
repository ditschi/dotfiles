#!/usr/bin/env bash
set -euo pipefail

# Non-interactive kinit: retrieves the password via get-password and pipes it to kinit.
# This must be a script (not a shell alias) so it is available to bash, cron jobs,
# and any other non-interactive context that has ~/.local/bin in PATH.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# On work hosts work-net applies the failure guard; a run in a terminal resets it.
if command -v work-net >/dev/null 2>&1; then
    auto=(--auto)
    [[ -t 2 ]] && auto=()
    exec work-net kerberos kinit "${auto[@]}" -- "$@"
fi

password=$("$SCRIPT_DIR/get-password")
printf '%s\n' "$password" | kinit "$@"
