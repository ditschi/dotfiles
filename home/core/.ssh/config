# SSH client config, versioned in dotfiles (home/core/.ssh/config).
# ssh takes the FIRST value of each option: host-only settings come first,
# then the host list of this context, and the shared defaults last.
#
#   ~/.ssh/config.local   this host only, never versioned or overwritten
#   ~/.ssh/config.d/*     host list from Bitwarden (machine ssh pull/add/edit)
#   ~/.ssh/config.d/90-legacy
#                         hosts of the hand-written config this file replaced that
#                         the list lacks, until cleaned up (machine attention)
#
# Network details (addresses, users, ports) never go into this file.

Include ~/.ssh/config.local
Include ~/.ssh/config.d/*

Host *
  # end a dead session after about two minutes instead of hanging
  ServerAliveInterval 30
  ServerAliveCountMax 4
  # reuse one connection per host for ssh, scp, rsync and git;
  # after a network change end a stale master with: ssh -O exit <host>
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 10m
  # offer only the configured and default keys, not everything in the agent
  IdentitiesOnly yes
  HashKnownHosts no
  # new keys go to the first file; the second is generated by machine
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/home
