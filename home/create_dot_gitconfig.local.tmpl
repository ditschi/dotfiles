# Host-local git config, included near the end of ~/.gitconfig; only the owner rules
# (remote URL -> work/private identity) come after it.
# Created once by chezmoi from the machine profile and never overwritten — edit freely.
# Put host-only settings here: signingkey/gpg, safe.directory, credential helpers, proxy.
# Per-repo exceptions: `git user-work` / `git user-private`.

[user]
{{- if eq .profile "work-machine" }}
    name = Ditscher Christian (XC-AS/ESE1)
    email = christian.ditscher@de.bosch.com
{{- else }}
    name = Christian Ditscher
    email = chris@ditscher.me
{{- end }}

[credential]
    helper = store
{{- if eq .profile "work-machine" }}

# The user-space Git (mise) ignores /etc/gitconfig and the system CA bundle.
[http]
    sslCAInfo = /etc/ssl/certs/ca-certificates.crt

[safe]
    directory = /opt/osd/ansible/osd-ansible-custom
{{- end }}
{{- if eq .profile "container" }}

[safe]
    directory = /workspace
{{- end }}
