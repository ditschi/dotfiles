    _exit(Machine().cmd_inventory(args))


@app.command(name="completion", help="print bash/zsh completion")
def completion_cmd(shell: str = typer.Argument(...)) -> None:
    typer.echo(_completion_script(shell), nl=False)


@app.command(name="help", help="show help")
def help_cmd(ctx: typer.Context) -> None:
    typer.echo(ctx.parent.get_help() if ctx.parent else ctx.get_help())


if __name__ == "__main__":
    try:
        app(prog_name=MACHINE_PROG_NAME)
    except KeyboardInterrupt:
        raise SystemExit(130)
    except subprocess.CalledProcessError as exc:
        die(f"command failed: {' '.join(map(str, exc.cmd))} (exit {exc.returncode})")
