#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11,<3.14"
# dependencies = [
#     # Pinned exactly: the `completion` subcommand reaches into typer's
#     # private _completion_classes/_completion_shared modules, which are not
#     # a stable API across typer releases. Bump deliberately and re-test
#     # `machine completion bash|zsh` before relaxing this.
#     "typer==0.27.2",
#     "rich>=13.9",
#     "pyyaml>=6.0",
#     "questionary>=2.0",
# ]
# ///
"""Unified machine CLI: orchestrate chezmoi + ansible; host answers; Bitwarden UX."""

from __future__ import annotations

import subprocess
import sys
import types
from pathlib import Path
from typing import List, Optional, Sequence

# The implementation lives next to this script: ~/.local/lib/machine_cli when
# deployed by chezmoi, home/dot_local/lib/machine_cli in the repository.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import typer  # noqa: E402
from typer._completion_classes import completion_init  # noqa: E402
from typer._completion_shared import get_completion_script  # noqa: E402

from machine_cli import core, system  # noqa: E402,F401
from machine_cli.core import (  # noqa: E402,F401
    MACHINE_PROG_NAME,
    PROFILES,
    FEATURE_HELP,
    FEATURES,
    PLAYBOOKS,
    ENV_GROUPS,
    SSH_CLASS,
    OLD_ROOT_LINK_NAMES,
    log,
    die,
    _IndentDumper,
    parse_profile_file,
    format_profile_yaml,
    profile_fingerprint,
    write_private,
)
from machine_cli.machine import Machine  # noqa: E402

# Registers the bash/zsh completion classes typer's own shell-completion
# dispatch needs; normally a side effect of add_completion=True, which we
# don't want (we expose our own `completion` subcommand instead).
completion_init()


def _choices(values: Sequence[str]):
    def complete(incomplete: str) -> List[str]:
        return [value for value in values if value.startswith(incomplete)]

    return complete


def _host_names(incomplete: str) -> List[str]:
    try:
        hosts = Machine().repo / "machine/hosts"
        names = [path.stem for path in hosts.glob("*.yml")]
    except Exception:  # completion must never print a traceback
        return []
    return sorted(n for n in names if not n.startswith("_") and n.startswith(incomplete))


def _offer_options_for_flag_only_commands() -> None:
    """Typer completes options only after `-`; also offer them on an empty word
    for commands without positional arguments (e.g. `machine setup <tab>`)."""
    # typer vendors click as typer._click (pinned version, see header).
    from typer.core import TyperArgument, TyperGroup
    from typer._click.shell_completion import _resolve_context, add_completion_class
    from typer._completion_classes import BashComplete, ZshComplete

    def extend(base):
        class WithOptions(base):
            def get_completions(self, args, incomplete):
                items = super().get_completions(args, incomplete)
                if items or incomplete:
                    return items
                ctx = _resolve_context(self.cli, self.ctx_args, self.prog_name, args)
                command = ctx.command
                if isinstance(command, TyperGroup) or any(
                    isinstance(param, TyperArgument) for param in command.params
                ):
                    return items
                return super().get_completions(args, "-")

        WithOptions.__name__ = base.__name__
        return WithOptions

    add_completion_class(extend(BashComplete), BashComplete.name)
    add_completion_class(extend(ZshComplete), ZshComplete.name)


try:
    _offer_options_for_flag_only_commands()
except (ImportError, AttributeError):
    pass  # plain typer behaviour on a changed click/typer layout


app = typer.Typer(
    name="machine",
    help="Dotfiles and host setup",
    add_completion=False,
    no_args_is_help=True,
)


@app.callback()
def _global_options(
    debug: bool = typer.Option(
        False,
        "--debug",
        envvar="DEBUG",
        help="show every command that is run; ansible runs with -v",
    ),
) -> None:
    core.set_debug(debug)


def _completion_script(shell: str) -> str:
    if shell not in ("bash", "zsh"):
        die(f"unsupported shell: {shell}")
    complete_var = f"_{MACHINE_PROG_NAME.upper()}_COMPLETE"
    return get_completion_script(
        prog_name=MACHINE_PROG_NAME, complete_var=complete_var, shell=shell
    )


def _exit(code: int) -> None:
    if code:
        raise typer.Exit(code=code)


def _check_choice(value: str, choices: Sequence[str], label: str) -> str:
    if value not in choices:
        die(f"invalid {label} {value!r} (choices: {', '.join(choices)})")
    return value


def _run_setup(args: types.SimpleNamespace) -> None:
    if args.profile:
        _check_choice(args.profile, PROFILES, "--profile")
    for feature in args.features or []:
        _check_choice(feature, FEATURES, "--features")
    _check_choice(args.playbook, PLAYBOOKS, "--playbook")
    _exit(Machine().cmd_setup(args))


@app.command(help="Bootstrap this host or --limit HOST")
def setup(
    profile: Optional[str] = typer.Option(
        None, "--profile", help="machine profile", autocompletion=_choices(PROFILES)
    ),
    features: Optional[List[str]] = typer.Option(
        None,
        "--features",
        help="repeat to select several",
        autocompletion=_choices(FEATURES),
    ),
    yes: bool = typer.Option(
        False, "--yes", "--non-interactive", help="non-interactive"
    ),
    local: bool = typer.Option(False, "--local", help="force local connection"),
    limit: str = typer.Option(
        "", "--limit", help="ansible host", autocompletion=_host_names
    ),
    playbook: str = typer.Option(
        "workstation", "--playbook", autocompletion=_choices(PLAYBOOKS)
    ),
    skip_ansible: bool = typer.Option(False, "--skip-ansible"),
    skip_chezmoi: bool = typer.Option(False, "--skip-chezmoi"),
    no_become: bool = typer.Option(False, "--no-become"),
) -> None:
    args = types.SimpleNamespace(
        profile=profile,
        features=features,
        yes=yes,
        local=local,
        limit=limit,
        playbook=playbook,
        skip_ansible=skip_ansible,
        skip_chezmoi=skip_chezmoi,
        no_become=no_become,
        command="setup",
    )
    _run_setup(args)


@app.command(
    help="Run only the steps the incoming changes need (--check: show them, change nothing)"
)
def update(
    apply_system: bool = typer.Option(False, "--system"),
    force: bool = typer.Option(
        False, "--force", help="stash local changes that overlap incoming ones"
    ),
    check: bool = typer.Option(False, "--check", help="read-only plan"),
    json: bool = typer.Option(False, "--json", help="with --check: machine-readable"),
    auto: bool = typer.Option(
        False, "--auto", help="background mode: apply home-only changes unattended"
    ),
) -> None:
    args = types.SimpleNamespace(
        system=apply_system, force=force, check=check, json=json, auto=auto
    )
    _exit(Machine().cmd_update(args))


@app.command(
    help="Sync host profile + ansible (local revert on fail; --limit for remote)"
)
def apply(
    limit: str = typer.Option(
        "", "--limit", help="ansible host", autocompletion=_host_names
    ),
    playbook: str = typer.Option(
        "workstation", "--playbook", autocompletion=_choices(PLAYBOOKS)
    ),
    no_become: bool = typer.Option(False, "--no-become"),
) -> None:
    _check_choice(playbook, PLAYBOOKS, "--playbook")
    args = types.SimpleNamespace(limit=limit, playbook=playbook, no_become=no_become)
    _exit(Machine().cmd_apply(args))


@app.command(
    name="profile", help="show/sync/save versioned machine/hosts/<hostname>.yml"
)
def profile_cmd(
    action: str = typer.Argument(
        "show", autocompletion=_choices(["show", "sync", "save"])
    ),
) -> None:
    _check_choice(action, ["show", "sync", "save"], "action")
    args = types.SimpleNamespace(action=action)
    _exit(Machine().cmd_profile(args))


@app.command(name="env", help="Bitwarden -> ~/.env")
def env_cmd(
    action: str = typer.Argument("pull", autocompletion=_choices(["pull", "status"])),
) -> None:
    _check_choice(action, ["pull", "status"], "action")
    cli = Machine()
    if action == "status":
        _exit(cli.cmd_env_status())
    else:
        _exit(cli.cmd_env_pull(interactive=True))


@app.command(name="ssh", help="publish/restore per-host SSH keys")
def ssh_cmd(
    action: str = typer.Argument(..., autocompletion=_choices(["publish", "restore"])),
    private: bool = typer.Option(False, "--private", help="also store private key"),
    yes: bool = typer.Option(False, "--yes"),
) -> None:
    _check_choice(action, ["publish", "restore"], "action")
    args = types.SimpleNamespace(action=action, private=private, yes=yes)
    _exit(Machine().cmd_ssh(args))


@app.command(help="git / chezmoi / profile")
def status() -> None:
    _exit(Machine().cmd_status())


@app.command(help="commit tracked changes")
def commit(
    message: Optional[str] = typer.Option(None, "-m", "--message"),
) -> None:
    args = types.SimpleNamespace(message=message)
    _exit(Machine().cmd_commit(args))


@app.command(help="git push")
def push() -> None:
    _exit(Machine().cmd_push())


@app.command(name="inventory", help="ansible-vault helpers")
def inventory_cmd(
    action: str = typer.Argument(
        ..., autocompletion=_choices(["edit", "encrypt", "decrypt", "view"])
    ),
    file: str = typer.Argument(...),
) -> None:
    _check_choice(action, ["edit", "encrypt", "decrypt", "view"], "action")
    args = types.SimpleNamespace(action=action, file=file)
    _exit(Machine().cmd_inventory(args))


@app.command(name="completion", help="print bash/zsh completion")
def completion_cmd(
    shell: str = typer.Argument(..., autocompletion=_choices(["bash", "zsh"])),
) -> None:
    typer.echo(_completion_script(shell), nl=False)


@app.command(name="help", help="show help")
def help_cmd(ctx: typer.Context) -> None:
    typer.echo(ctx.parent.get_help() if ctx.parent else ctx.get_help())


if __name__ == "__main__":
    try:
        app(prog_name=MACHINE_PROG_NAME)
    except KeyboardInterrupt:
        raise SystemExit(130)
    except subprocess.CalledProcessError as exc:
        die(f"command failed: {' '.join(map(str, exc.cmd))} (exit {exc.returncode})")
