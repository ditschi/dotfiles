#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     # Pinned exactly: the `completion` subcommand reaches into typer's
#     # private _completion_classes/_completion_shared modules, which are not
#     # a stable API across typer releases. Bump deliberately and re-test
#     # `machine completion bash|zsh` before relaxing this.
#     "typer==0.27.2",
#     "rich>=13.9",
#     "pyyaml>=6.0",
# ]
# ///
"""Unified machine CLI: orchestrate chezmoi + ansible; host answers; Bitwarden UX."""
