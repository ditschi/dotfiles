# Own Ghostty settings, shared through the dotfiles (group niri, like dotfiles.kdl for niri).
# Included last from ~/.config/ghostty/config (written by DMS) with
# `config-file = ?dotfiles.ghostty`, which machine adds once; settings here win over DMS's.

# Drop-down terminal of the niri session (F12 → ghostty +toggle-quick-terminal).
quick-terminal-position = top
quick-terminal-size = 45%, 85%
quick-terminal-autohide = true

# ssh: install Ghostty's terminfo on the remote host on first login, else fall back to
# TERM=xterm-256color (without it zsh-autosuggestions leaves garbage on hosts that do
# not know xterm-ghostty). A list here replaces DMS's whole list, so it repeats DMS's
# cursor/sudo/title choice.
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# Selecting text copies it to the primary selection (middle-click paste); DMS sets false.
copy-on-select = true
