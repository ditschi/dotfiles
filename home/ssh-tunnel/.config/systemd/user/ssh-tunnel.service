# Reverse SSH tunnel to the jump host (feature ssh-tunnel); see ~/.local/bin/ssh-tunnel.
# Enabled by machine update; linger starts it at boot without a login. A user unit
# cannot wait for the system's network-online.target: until the network is up ssh
# fails and the restart below tries again every 30 s.
[Unit]
Description=Reverse SSH tunnel to the jump host
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/ssh-tunnel
Restart=always
RestartSec=30
# 78: no jump route for this host in the host list; restarting would not help.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
