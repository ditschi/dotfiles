def _host_names(ctx, param, incomplete):
    try:
        hosts = Machine().repo / "machine/hosts"
        names = [path.stem for path in hosts.glob("*.yml")]
    except Exception:  # completion must never print a traceback
        return []
    return sorted(n for n in names if not n.startswith("_") and n.startswith(incomplete))


def _offer_options_on_empty_word(base):
    """Click completes options only after `-`; also offer them when an empty
    word has no other candidates (e.g. `machine setup <tab>`)."""

    class WithOptions(base):
        def get_completions(self, args, incomplete):
            items = super().get_completions(args, incomplete)
            if items or incomplete:
                return items
            return super().get_completions(args, "-")

    WithOptions.__name__ = base.__name__
    return WithOptions


add_completion_class(_offer_options_on_empty_word(BashComplete), BashComplete.name)
add_completion_class(_offer_options_on_empty_word(ZshComplete), ZshComplete.name)


@click.group(name="machine", help="Dotfiles and host setup", no_args_is_help=True)
@click.option(
    "--debug",
    is_flag=True,
    envvar="DEBUG",
    help="show every command that is run; ansible runs with -v",
)
@click.pass_context
def app(ctx: click.Context, debug: bool) -> None:
    core.set_debug(debug)
    if ctx.invoked_subcommand not in (None, "update", "completion", "help"):
        Machine().event("usage", "invoked", ctx.invoked_subcommand)


def _exit(code: int) -> None:
    if code:
        raise SystemExit(code)


PLAYBOOK_CHOICE = click.Choice(PLAYBOOKS)


@app.command(help="Bootstrap this host or --limit HOST")
@click.option("--profile", type=click.Choice(PROFILES), help="machine profile")
@click.option(
    "--features",
    multiple=True,
    type=click.Choice(FEATURES),
    help="repeat to select several",
)
@click.option("--yes", "--non-interactive", "yes", is_flag=True, help="non-interactive")
@click.option("--local", is_flag=True, help="force local connection")
@click.option("--limit", default="", help="ansible host", shell_complete=_host_names)
@click.option("--playbook", type=PLAYBOOK_CHOICE, default="workstation")
@click.option("--skip-ansible", is_flag=True)
@click.option("--skip-dotfiles", is_flag=True)
@click.option("--no-become", is_flag=True)
def setup(
    profile, features, yes, local, limit, playbook, skip_ansible, skip_dotfiles, no_become
) -> None:
    args = types.SimpleNamespace(
        profile=profile,
        features=list(features) or None,
        yes=yes,
        local=local,
        limit=limit,
        playbook=playbook,
        skip_ansible=skip_ansible,
        skip_dotfiles=skip_dotfiles,
        no_become=no_become,
        command="setup",
    )
    _exit(Machine().cmd_setup(args))


@app.command(
    help="Run only the steps the incoming changes need (--check: show them, change nothing)"
)
@click.option("--system", "apply_system", is_flag=True)
@click.option(
    "--force", is_flag=True, help="stash local changes that overlap incoming ones"
)
@click.option("--check", is_flag=True, help="read-only plan")
@click.option("--json", "json_", is_flag=True, help="with --check: machine-readable")
@click.option(
    "--auto", is_flag=True, help="background mode: apply home-only changes unattended"
)
def update(apply_system, force, check, json_, auto) -> None:
    args = types.SimpleNamespace(
        system=apply_system, force=force, check=check, json=json_, auto=auto
    )
    _exit(Machine().cmd_update(args))


@app.command(
    help="Sync host profile + ansible (local revert on fail; --limit for remote)"
)
@click.option("--limit", default="", help="ansible host", shell_complete=_host_names)
@click.option("--playbook", type=PLAYBOOK_CHOICE, default="workstation")
@click.option("--no-become", is_flag=True)
def apply(limit, playbook, no_become) -> None:
    args = types.SimpleNamespace(limit=limit, playbook=playbook, no_become=no_become)
    _exit(Machine().cmd_apply(args))


@app.command(
    name="profile", help="show/sync/save versioned machine/hosts/<hostname>.yml"
)
@click.argument("action", type=click.Choice(["show", "sync", "save"]), default="show")
def profile_cmd(action) -> None:
    _exit(Machine().cmd_profile(types.SimpleNamespace(action=action)))


@app.command(name="env", help="Bitwarden -> ~/.env")
@click.argument("action", type=click.Choice(["pull", "status"]), default="pull")
def env_cmd(action) -> None:
    cli = Machine()
    code = cli.cmd_env_status() if action == "status" else cli.cmd_env_pull(interactive=True)
    if code:
        cli.event("env", "failed", action)
    _exit(code)


@app.command(name="ssh", help="publish/restore per-host SSH keys")
@click.argument("action", type=click.Choice(["publish", "restore"]))
@click.option("--private", is_flag=True, help="also store private key")
@click.option("--yes", is_flag=True)
def ssh_cmd(action, private, yes) -> None:
    args = types.SimpleNamespace(action=action, private=private, yes=yes)
    cli = Machine()
    code = cli.cmd_ssh(args)
    if code:
        cli.event("ssh", "failed", action)
    _exit(code)


