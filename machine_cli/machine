@app.command(name="inventory", help="ansible-vault helpers")
@click.argument("action", type=click.Choice(["edit", "encrypt", "decrypt", "view"]))
@click.argument("file")
def inventory_cmd(action, file) -> None:
    _exit(Machine().cmd_inventory(types.SimpleNamespace(action=action, file=file)))


@app.command(name="completion", help="print bash/zsh completion")
@click.argument("shell", type=click.Choice(["bash", "zsh"]))
def completion_cmd(shell) -> None:
    complete_var = f"_{MACHINE_PROG_NAME.upper()}_COMPLETE"
    cls = get_completion_class(shell)
    click.echo(cls(app, {}, MACHINE_PROG_NAME, complete_var).source(), nl=False)


@app.command(name="help", help="show help")
@click.pass_context
def help_cmd(ctx) -> None:
    click.echo(ctx.parent.get_help() if ctx.parent else ctx.get_help())


if __name__ == "__main__":
    try:
        app(prog_name=MACHINE_PROG_NAME)
    except KeyboardInterrupt:
        raise SystemExit(130)
    except subprocess.CalledProcessError as exc:
        die(f"command failed: {' '.join(map(str, exc.cmd))} (exit {exc.returncode})")
