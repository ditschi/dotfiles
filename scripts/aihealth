#!/usr/bin/env bash
# ai-health pinned to one commit, the only place that holds the pin (docs/code-health.md).
# Arguments go to ai-health unchanged; always pass --config (.aihealth.toml, or
# .aihealth-tests.toml for tests/).
set -euo pipefail
exec uvx --quiet --from "git+https://github.com/epatel/ai-health@033d1867fe514867d944d9387ee72db0188eed47" aihealth "$@"
